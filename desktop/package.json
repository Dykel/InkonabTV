{
  "name": "inkonabtv-desktop",
  "productName": "InkonabTV",
  "version": "1.0.29",
  "description": "InkonabTV for Windows and Mac: the InkonabTV player as a desktop app, with a built-in free VPN",
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copy-web": "node copy-web.mjs",
    "start": "npm run copy-web && electron .",
    "dist:win": "npm run copy-web && electron-builder --win --x64",
    "release:windows": "npm run dist:win && node ../scripts/release-desktop.mjs win",
    "dist:store": "node copy-web.mjs --store && electron-builder --win --x64 --config store.config.js",
    "dist:mac": "npm run copy-web && electron-builder --mac --universal --config.directories.output=../release/mac",
    "release:mac": "npm run dist:mac && node ../scripts/release-desktop.mjs mac"
  },
  "build": {
    "appId": "tv.inkonab.desktop",
    "productName": "InkonabTV",
    "files": [
      "main.js",
      "preload.js",
      "vpn.js",
      "media.js",
      "updater.js",
      "www/**/*"
    ],
    "directories": {
      "output": "../release/windows"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vendor/openvpn/win",
          "to": "openvpn",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "vendor/ffmpeg/win",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "shortcutName": "InkonabTV",
      "include": "build/installer.nsh",
      "artifactName": "inkonabtv.exe"
    },
    "afterPack": "build/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "vendor/openvpn/mac",
          "to": "openvpn",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "vendor/ffmpeg/mac",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ],
      "x64ArchFiles": "Contents/Resources/{ffmpeg/ffmpeg,openvpn/openvpn}"
    },
    "dmg": {
      "artifactName": "inkonabtv.dmg",
      "title": "InkonabTV"
    }
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0"
  }
}
