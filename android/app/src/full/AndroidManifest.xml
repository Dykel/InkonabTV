<?xml version="1.0" encoding="utf-8"?>
<!-- Sideload ("full") version only: the built-in free VPN (VPN Gate servers through OpenVPN). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The OpenVPN engine (libovpnexec.so) runs as a process, so native libs are extracted to disk. -->
    <application android:extractNativeLibs="true">
        <!-- App-only VPN used when a channel won't play. -->
        <service
            android:name=".vpn.InkonabVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>
    </application>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
</manifest>
